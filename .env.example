# Copy to .env for local runs (docker compose supplies these itself).

# Main service database
DATABASE_URL=postgresql+psycopg://ccdev:ccdev@127.0.0.1:5432/ccdev
# Dedicated database used by pytest (created automatically)
TEST_DATABASE_URL=postgresql+psycopg://ccdev:ccdev@127.0.0.1:5432/ccdev_test
# Used only to CREATE DATABASE when the target database does not exist
ADMIN_DATABASE_URL=postgresql+psycopg://ccdev:ccdev@127.0.0.1:5432/postgres

# Create tables on startup (idempotent). Set false in environments with migrations.
CROSSBORDER_AUTO_CREATE_SCHEMA=true
